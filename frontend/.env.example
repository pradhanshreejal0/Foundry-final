# =====================================================
# Foundry Frontend Environment Variables Example
# Copy this file to .env and fill in real values. NEVER commit .env
# =====================================================

# Optional: Set VITE_API_URL only if bypassing the same-origin /api proxy on Vercel.
# Leave blank or unset in production so requests go to same-origin /api and get proxied by Vercel.
VITE_API_URL=
