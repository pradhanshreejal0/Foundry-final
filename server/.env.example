# =====================================================
# Foundry Server Environment Variables Example
# Copy this file to .env and fill in real values. NEVER commit .env
# =====================================================

# Server Port (default 5000)
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/foundry?retryWrites=true&w=majority

# JWT Secrets (Must be at least 32 random characters in production)
JWT_SECRET=super_secret_jwt_access_key_change_me_32_chars_min
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_me_32_chars_min

# Public URL of the primary site (used for emails, payment return URLs, redirects)
PUBLIC_URL=https://example.com

# Allowed origins for CORS (comma-separated list of allowed frontend domains)
ALLOWED_ORIGINS=https://example.com,https://www.example.com,http://localhost:5173

# Proxy configuration (Number of trusted proxy hops, e.g., 2 for Vercel -> Render)
TRUST_PROXY_HOPS=2

# Cookie configuration
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Online Payments Feature Flag (false = COD only, true = eSewa & Khalti enabled)
ONLINE_PAYMENTS_ENABLED=false

# Cloudinary Image Upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email / Nodemailer Configuration (Provider agnostic SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@example.com

# Admin Seed Credentials (used by seedAdmin.js)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecureAdminPassword123!
